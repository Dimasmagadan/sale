---
import Layout from '../layouts/Layout.astro';
import ItemCard from '../components/ItemCard.astro';
import { siteConfig } from '../config/site.config';
import { readdir, readFile } from 'node:fs/promises';
import { join } from 'node:path';
import type { ImageMetadata } from 'astro';

const basePath = siteConfig.basePath || '';

type Item = {
  slug: string;
  title: string;
  price: number;
  condition: string;
  availability: 'available' | 'sold';
  images?: string[];
  [key: string]: any;
};

// Load all items from content/items directory
const itemsDir = join(process.cwd(), 'content', 'items');
const itemFiles: string[] = await readdir(itemsDir);

// Map local assets by filename to ImageMetadata
const modules = import.meta.glob('../assets/items/*', { eager: true }) as Record<string, any>;
const assetsByName = new Map<string, ImageMetadata>();
for (const [path, mod] of Object.entries(modules)) {
  const meta = (mod as any).default ?? (mod as any);
  const name = path.split('/').pop();
  if (name) assetsByName.set(name, meta as ImageMetadata);
}

const items = await Promise.all(
  itemFiles
    .filter((file: string) => file.endsWith('.json'))
    .map(async (file: string) => {
      const content = await readFile(join(itemsDir, file), 'utf-8');
      const item: Item = JSON.parse(content);
      const slug = file.replace('.json', '');
      const imagePath = item.images?.[0] || '/placeholder.jpg';
      const fileName = typeof imagePath === 'string' ? imagePath.split('/').pop() : null;
      const imageMeta = fileName ? assetsByName.get(fileName) : undefined;
      return {
        ...item,
        slug,
        image: imageMeta
      };
    })
);

// Filter only available items
const availableItems: Item[] = (items as Item[]).filter((item: Item) => item.availability === 'available');

// Sort items by price
const sortedItems: Item[] = availableItems.sort((a: Item, b: Item) => a.price - b.price);

const availableCount = availableItems.length;
const itemWord = availableCount === 1
  ? 'товар'
  : availableCount >= 2 && availableCount <= 4
    ? 'товара'
    : 'товаров';
---

<Layout title={siteConfig.name} description={siteConfig.description}>
  <div class="bg-gradient-to-b py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl sm:text-5xl font-bold mb-4 text-[var(--color-text)]">
          Детские товары
        </h1>
        <p class="text-lg sm:text-xl max-w-2xl mx-auto text-[var(--color-text-light)]">
          Выбирайте детские вещи новые и б/у в отличном состоянии!
        </p>
        
        <div class="mt-6 bg-gradient-to-r from-green-50 to-emerald-50 border-2 border-green-300 rounded-lg p-6 max-w-2xl mx-auto mb-6 shadow-lg">
          <div class="text-center">
            <p class="text-2xl font-bold text-green-800 mb-2">
              🎉 Специальное предложение!
            </p>
            <p class="text-lg text-green-700 mb-3">
              Купите весь комплект всего за <span class="text-3xl font-extrabold text-green-900">10&nbsp;000&nbsp;₽</span>
            </p>
            <p class="text-sm text-green-600 mb-4">
              По отдельности стоят <span class="line-through">18&nbsp;500&nbsp;₽</span> — экономия <span class="font-bold">8&nbsp;500&nbsp;₽!</span>
            </p>
            <div class="text-left max-w-md mx-auto bg-white/50 rounded-lg p-4 mt-4">
              <p class="text-sm font-semibold text-green-800 mb-2">В комплект входит:</p>
              <ul class="text-sm text-green-700 space-y-1">
                <li>✓ Кокон для новорожденных "Зевушка"</li>
                <li>✓ Детская кроватка-трансформер 9-в-1</li>
                <li>✓ Круглый матрас (75×75 см) </li>
                <li>✓ Овальный матрас (125×75 см)</li>
                <li>✓ Подушка для кормления Dagmar Kids</li>
                <li>✓ Складная ванночка с матрасиком</li>
                <li>✓ Горка для купания Kidwick</li>
              </ul>
            </div>
            <div class="mt-5">
              <a 
                href={`https://t.me/${siteConfig.telegram.username}?text=${encodeURIComponent('Здравствуйте, хочу купить весь комплект за 10 000 ₽')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-white px-6 py-3 rounded-lg font-semibold text-base transition-all shadow-md hover:shadow-lg bg-green-600 hover:bg-green-700"
                onclick="try{ym(106420786, 'reachGoal', 'telegram_click_bundle')}catch(e){}"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.121l-6.869 4.326-2.96-.924c-.64-.203-.658-.64.135-.954l11.566-4.458c.538-.196 1.006.128.832.941z"/>
                </svg>
                Купить весь комплект
              </a>
            </div>
          </div>
        </div>
        
        <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4 max-w-2xl mx-auto mb-6">
          <p class="text-slate-700 font-medium text-sm">
            <strong>📍 Местоположение:</strong> Все товары находятся на территории ЖК Босфор (Новороссийск, Алексея Матвейкина 1а). Доставки нет, только самовывоз.
          </p>
        </div>
        
        <div class="mt-6 inline-flex items-center gap-2 text-sm text-[var(--color-text-light)]">
          <span class="inline-block w-3 h-3 rounded-full bg-[var(--color-accent)]"></span>
          <span class="font-medium">{availableCount} {itemWord} в наличии</span>
        </div>
      </div>

      {availableItems.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-lg text-[var(--color-text-light)]">Сейчас нет доступных товаров. Загляните позже!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedItems.map((item) => (
            <ItemCard
              slug={item.slug}
              title={item.title}
              price={item.price}
              image={item.image}
              condition={item.condition}
              availability={item.availability}
            />
          ))}
        </div>
      )}

      <div class="mt-12 text-center">
        <a 
          href={siteConfig.telegram.link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-white px-8 py-3 rounded-lg font-semibold text-lg transition-colors shadow-md hover:shadow-lg bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)]"
          onclick="try{ym(106420786, 'reachGoal', 'telegram_click')}catch(e){}"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.295-.6.295-.002 0-.003 0-.005 0l.213-3.054 5.56-5.022c.24-.213-.054-.334-.373-.121l-6.869 4.326-2.96-.924c-.64-.203-.658-.64.135-.954l11.566-4.458c.538-.196 1.006.128.832.941z"/>
          </svg>
          Написать в Telegram
        </a>
      </div>
    </div>
  </div>
</Layout>
