---
import { Image } from 'astro:assets';
import { siteConfig } from '../config/site.config';

interface Props {
  slug: string;
  title: string;
  price: number;
  image: string;
  condition: string;
  availability: 'available' | 'sold';
}

const { slug, title, price, image, condition, availability } = Astro.props;
const isAvailable = availability === 'available';
const basePath = siteConfig.basePath || '';
---

<article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300 flex flex-col h-full">
  <a href={`${basePath}/items/${slug}`} class="block relative">
    <div class="aspect-square overflow-hidden bg-slate-100">
      <Image 
        src={image} 
        alt={title}
        class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
        width={600}
        height={600}
        loading="lazy"
      />
    </div>
    {!isAvailable && (
      <div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center">
        <span class="bg-red-600 text-white px-4 py-2 rounded-lg font-bold text-lg">
          Продано
        </span>
      </div>
    )}
  </a>
  
  <div class="p-4 flex-1 flex flex-col">
    <a href={`${basePath}/items/${slug}`} class="block">
      <h3 class="font-semibold text-lg mb-2 transition-colors line-clamp-2 text-[var(--color-text)] hover:text-[var(--color-primary)]">
        {title}
      </h3>
    </a>
    
    <div class="mt-auto space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-2xl font-bold text-[var(--color-primary)]">
          {price}₽
        </span>
        <span class="text-sm px-2 py-1 rounded text-[var(--color-text-light)] bg-slate-100">
          {condition}
        </span>
      </div>
      
      <a 
        href={`${basePath}/items/${slug}`}
        class={`block w-full text-center py-2 rounded-lg font-medium transition-colors ${
          isAvailable 
            ? 'bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white' 
            : 'bg-[var(--color-secondary)] text-[var(--color-text-light)] cursor-not-allowed'
        }`}
      >
        {isAvailable ? 'Подробнее' : 'Продано'}
      </a>
    </div>
  </div>
</article>
